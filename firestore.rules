rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPlatformOwner() {
      return signedIn() && request.auth.token.email == "orquestracs@gmail.com";
    }

    function belongsToTenant(tenantId) {
      return signedIn()
        && exists(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid));
    }

    function tenantRole(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.role;
    }

    function canReadTenant(tenantId) {
      return isPlatformOwner() || belongsToTenant(tenantId);
    }

    function canWriteTenant(tenantId) {
      return isPlatformOwner()
        || (belongsToTenant(tenantId) && tenantRole(tenantId) in ["owner", "admin"]);
    }

    function isTenantOwner(tenantId) {
      return isPlatformOwner()
        || (belongsToTenant(tenantId) && tenantRole(tenantId) == "owner");
    }

    match /companies/{companyId} {
      allow read: if canReadTenant(companyId);
      allow create, update: if canWriteTenant(companyId);
      allow delete: if false;

      match /employees/{employeeId} {
        allow read: if canReadTenant(companyId);
        allow create, update: if canWriteTenant(companyId);
        allow delete: if false;

        match /faceId/{recordId} {
          allow read: if canReadTenant(companyId);
          allow create: if canWriteTenant(companyId);
          allow update, delete: if false;
        }
      }

      match /journeys/{journeyId} {
        allow read: if canReadTenant(companyId);
        allow create, update: if canWriteTenant(companyId);
        allow delete: if false;
      }

      match /punches/{punchId} {
        allow read: if canReadTenant(companyId);
        allow create: if canWriteTenant(companyId);
        allow update, delete: if false;
      }

      match /adjustments/{adjustmentId} {
        allow read: if canReadTenant(companyId);
        allow create: if canWriteTenant(companyId);
        allow update, delete: if false;
      }

      match /auditLogs/{logId} {
        allow read: if canReadTenant(companyId);
        allow create: if canWriteTenant(companyId);
        allow update, delete: if false;
      }

      match /reports/{reportId} {
        allow read: if canReadTenant(companyId);
        allow create: if canWriteTenant(companyId);
        allow update, delete: if false;
      }

      match /{document=**} {
        allow read: if canReadTenant(companyId);
        allow write: if false;
      }
    }

    match /tenants/{tenantId} {
      allow read: if canReadTenant(tenantId);
      allow create: if isPlatformOwner();
      allow update: if isTenantOwner(tenantId);
      allow delete: if false;

      match /users/{userId} {
        allow read: if canReadTenant(tenantId);
        allow create: if isPlatformOwner()
          || (
            signedIn()
            && request.auth.uid == userId
            && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode))
            && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.tenantId == tenantId
            && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.status == "Ativo"
            && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.expiresAt > request.time
          );
        allow update: if isTenantOwner(tenantId)
          || (signedIn() && request.auth.uid == userId && request.resource.data.role == resource.data.role);
        allow delete: if false;
      }

      match /{document=**} {
        allow read: if canReadTenant(tenantId);
        allow write: if false;
      }
    }

    match /userTenants/{userId}/memberships/{tenantId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if isPlatformOwner()
        || (
          signedIn()
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/tenants/$(tenantId)/users/$(userId))
        );
      allow update, delete: if false;
    }

    match /invites/{code} {
      allow read: if signedIn() && (
        isPlatformOwner()
        || resource.data.status == "Ativo"
        || isTenantOwner(resource.data.tenantId)
      );
      allow create: if isPlatformOwner() || isTenantOwner(request.resource.data.tenantId);
      allow update: if signedIn() && (
        isPlatformOwner()
        || isTenantOwner(resource.data.tenantId)
        || (
          resource.data.status == "Ativo"
          && request.resource.data.status == "Usado"
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.tenantId == resource.data.tenantId
          && request.resource.data.role == resource.data.role
        )
      );
      allow delete: if false;
    }
  }
}
